# Copy to .env and fill in from the Supabase dashboard (Connect → App Frameworks).
# Both values are public-safe: they ship inside the built app, and Row-Level
# Security is what actually protects the data. The service_role / secret key
# must never appear here.
#
# The URL is the base form — no /rest/v1/ suffix.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
